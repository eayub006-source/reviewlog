# Local development: copy this file to .env and fill in the secret values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
TMDB_API_KEY=replace-with-your-tmdb-api-key

# Comma-separated domains accepted by Django's Host header validation.
ALLOWED_HOSTS=localhost,127.0.0.1,reviewlog.onrender.com,reviewlog.vercel.app,reviewlog-2lafwjpe0-eshal-s-projects2.vercel.app

# Comma-separated frontend origins allowed to call the Django API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://reviewlog.vercel.app,https://reviewlog-2lafwjpe0-eshal-s-projects2.vercel.app

# Production-only Render settings.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=true
